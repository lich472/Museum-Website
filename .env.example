# Copy this file to `.env` in the repository root and fill in real values.
# `.env` is gitignored (see .gitignore) and must never be committed; this
# example file is the one that IS committed, so it contains no secrets.
#
# The server loads the root .env (backend/server.ts calls dotenv twice: first
# backend/.env, then the repository root), and `npm run seed` reads the same
# root file.

# Required. MongoDB connection string, used by the server
# (backend/lib/db.ts) and by the seed script (npm run seed). The database name
# at the end of the path is the one both of them read and write.
MONGO_URI=

# Required. Signing keys for the JWTs the auth endpoints issue
# (backend/controllers/auth.controller.ts -> generateTokens). Any long random
# string works locally; use separate, freshly generated values per environment.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Optional. Redis holds the refresh tokens (storeRefreshToken in
# backend/controllers/auth.controller.ts). When this is unset,
# backend/lib/redis.ts falls back to an in-process memory store: tokens are
# lost on restart and are not shared between instances, so the fallback is for
# development only. A deployment must set this — with NODE_ENV=production and
# no URL the server refuses to start rather than silently downgrading.
UPSTASH_REDIS_URL=

# Optional. Comma-separated list of browser origins allowed to make
# credentialed requests (backend/server.ts). Defaults to
# http://localhost:5173 when unset. List every dev port and deployed origin,
# for example: http://localhost:5173,https://museum.example.org
CORS_ORIGINS=

# Optional. Port the API listens on (backend/server.ts). Defaults to 5001.
# The Vite dev server proxies /api to it.
PORT=5001
